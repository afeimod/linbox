# linbox: wine-9.x/proton_9.0 arm64ec rpcrt4 EC thunks 根治（v3.2.26）
#
# 【v3.2.25 的两处致命 bug（CI wine-build-log-arm64ec.zip 实证）】
#
# 1) ##num 粘贴接收表达式参数：
#     v3.2.25 的 EC 分支复用 cpsf.h 的 ALL_THUNK_ENTRIES，其
#     THUNK_ENTRY_BLOCK 传入 32*(block)+n 表达式；##num 只与首 token
#     粘贴 → "NdrProxyForwardingFunction32 * (1) + 0(void)" 连串
#     解析错误（cstub.c:176 / cproxy.c:241，"variable has incomplete
#     type 'void'" / "expected ';' after top level declarator"）。
#     上游 wine-10 thunks.c 即为此改为 T(3)…T(1023) 字面量枚举。
# 2) 符号名错误：call_stubless_func 尾调 wine-9.7 的 NdrpClientCall2，
#     proton_9.0 树里该函数叫 ndr_client_call（LONG_PTR CDECL，非
#     static；cproxy.c aarch64 分支的 bl 本就指向它）—— 就算宏修好，
#     链接也必炸 undefined symbol。
#
# 【v3.2.26 修法】
#  * cstub.c / cproxy.c EC 分支：字面量枚举（3..1023，1021 个）生成
#    独立 naked 函数 + 函数指针表；函数体照 aarch64 版（该 CI 的
#    aarch64 趟每天在编的指令序列）；
#  * call_stubless_func 逐字对齐 wine-9.7 ndr_stubless.c 的
#    __arm64ec__ naked 入口模式（.seh_proc "#name" 引号语法在
#    wine master 仍存 4 处，llvm-mingw 实证可编），callee 改
#    ndr_client_call；
#  * delegating_vtbl / stubless_thunk_table 的 EC 填充与
#    fill_stubless_table 的查表路径不变（v3.2.25 已对）。
#
# 【树自适应】EC callee（call_stubless_func 的尾调符号）按树互异：
#   * proton_9.0/wine-9.0：ndr_client_call（LONG_PTR CDECL，非 static）
#   * wine-9.7：NdrpClientCall2（ndr_client_call 在 9.7 为 static，
#     跨 TU 不可见）—— 两符号 4 参签名同形（stub_desc, format,
#     stack_top, fpu_stack），EC 汇编 x0-x3 传参通用。
# 本补丁按 proton_9.0 形态产出（当前 CI 主战场）；wine-9.7 树由
# build.sh 的 0013 EC callee 自适应段原地换名（树探测 = cproxy.c
# 原生分支自带的本树符号）+ 硬校验兜底。
#
# 【已验证】本地 proton_9.0 与 wine-9.7 两树全链重放（0007c→0007→
# 0013；w97 树含 build.sh callee 换名模拟）+ gcc -E 宏展开层复现旧
# 错误/验证新输出（NdrProxyForwardingFunction1023 等 1021 符号完整、
# 无粘贴残渣）；补丁对两树全部 hunk 干净应用。
#
# 【互斥】锚点为 0007c（cstub）+ 0007（cproxy x64 守卫）应用后的
# proton_9.0/wine-9.x 形态；wine-10+ 树 cproxy/cstub 已重写 → hunk
# 全不命中 → 静默跳过。
--- a/dlls/rpcrt4/cstub.c       2026-11-08 04:09:17.197974290 +0000
+++ b/dlls/rpcrt4/cstub.c       2026-11-08 04:09:17.201974301 +0000
@@ -146,13 +146,92 @@
     ".long 8*("#num")\n\t"
 
 #elif defined(__arm64ec__)
-/* linbox: arm64ec 编译趟禁用 x64 thunk 裸汇编（EC clang 不认 x86 指令，
- * 上游 wine-10 已整段重写为纯 C；旧树 EC 只求可编译，空桩与上游对不支持
- * 架构的 #else 兜底同款，delegating stubs 在 EC 无实际用户） */
-#define THUNK_ENTRY_SIZE 0
-#define THUNK_ENTRY(num) ""
