+    p_fluid_synth_cc = NULL;
+    p_fluid_synth_program_change = NULL;
+    p_fluid_synth_pitch_bend = NULL;
+    p_new_fluid_audio_driver = NULL;
+    p_delete_fluid_audio_driver = NULL;
+    p_fluid_synth_key_pressure = NULL;
