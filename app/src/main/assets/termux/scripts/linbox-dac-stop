#!/data/data/com.linbox/files/usr/bin/sh
# linbox-dac-stop — 关闭 DAC 显示窗口与侧车 (v1.3, POSIX sh)
P="${PREFIX:-/data/data/com.linbox/files/usr}"
am broadcast -a com.linbox.action.DAC_STOP >/dev/null 2>&1 || true
if [ -f "$P/tmp/linbox-dac-allocd.pid" ]; then
    kill "$(cat "$P/tmp/linbox-dac-allocd.pid")" 2>/dev/null || true
    rm -f "$P/tmp/linbox-dac-allocd.pid" "$P/tmp/linbox-dac-allocd.sock"
fi
rm -f "$P/tmp/linbox-dac.sock"
echo "[linbox-dac-stop] 已停止"
