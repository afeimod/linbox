#!/data/data/com.linbox/files/usr/bin/sh
# ============================================================
# linbox-dac-reg — 注册 winedac.drv 为 wine 图形驱动 (v1.3, POSIX sh)
# 用法: linbox-dac-reg [宽] [高]
# ============================================================
# 机制：wine 读取 HKCU\Software\Wine\Drivers 的 "Graphics" 值决定加载哪个
# 图形驱动（"dac" → winedac.drv，与 "x11" → winex11.drv 同机制）。
# 优先用 wine reg add 写（最可靠）；wine 不可用时直接文本改 user.reg
#（wineboot 下次启动生效）。
# ============================================================

WP="${WINEPREFIX:-$HOME/.wine}"
USER_REG="$WP/user.reg"

log() { printf '[linbox-dac-reg] %s\n' "$*"; }

run_wine_reg() {
    WINE_BIN="$(command -v wine 2>/dev/null || command -v wine64 2>/dev/null)"
    [ -n "$WINE_BIN" ] || return 1
    WINE_REAL="$(readlink -f "$WINE_BIN" 2>/dev/null)"
    if [ -n "$WINE_REAL" ] && file "$WINE_REAL" 2>/dev/null | grep -Eq 'ld-linux|glibc' \
            && command -v grun >/dev/null 2>&1; then
        grun wine reg add 'HKCU\Software\Wine\Drivers' /v Graphics /t REG_SZ /d dac /f
    else
        wine reg add 'HKCU\Software\Wine\Drivers' /v Graphics /t REG_SZ /d dac /f
    fi
}

if [ -d "$WP" ] && run_wine_reg; then
    log "已通过 wine reg 设置 Graphics=dac (prefix: $WP)"
    exit 0
fi

# ---- 回退：文本方式改 user.reg ----
[ -f "$USER_REG" ] || { log "未找到 $USER_REG（先运行一次 wineboot 初始化 prefix）"; exit 1; }

# 一趟 awk 完成：删除段落内旧 "Graphics" 行 + 在段头后插入新值；段落缺失则追加
# 注意：user.reg 中反斜杠为双写（Software\\Wine\\Drivers），awk 字符串中需四写
if awk '
    /^\[Software\\\\Wine\\\\Drivers\]/ {
        print
        print "\"Graphics\"=\"dac\""
        ins=1; done=1
        next
    }
    ins && /^\[/ { ins=0 }
    ins && /^"Graphics"=/ { next }
    { print }
    END {
        if (!done) {
            print ""
            print "[Software\\\\Wine\\\\Drivers]"
            print "\"Graphics\"=\"dac\""
        }
    }
' "$USER_REG" > "$USER_REG.tmp" && [ -s "$USER_REG.tmp" ]; then
    mv "$USER_REG.tmp" "$USER_REG"
    log "已写入 $USER_REG (Graphics=dac)"
else
    rm -f "$USER_REG.tmp"
    log "awk 处理失败，user.reg 未改动"
    exit 1
fi
