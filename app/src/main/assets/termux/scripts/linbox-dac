#!/data/data/com.linbox/files/usr/bin/sh
# ============================================================
# LinBox DAC — Direct Android Compositing 一键启动 (v1.0)
# ============================================================
# 跳过 X11 的 Wine 呈现路径：
#   DXVK → AHardwareBuffer → SurfaceFlinger（直接合成）
#
# 用法：
#   linbox-dac doctor              体检（依赖/驱动/设备逐项检查）
#   linbox-dac game.exe            启动 exe（自动开 DAC 窗口 + 配置 wine）
#   linbox-dac -s 1280x720 game.exe  指定虚拟桌面分辨率（默认 1280x720）
#   linbox-dac --x11 game.exe      不改注册表，直接跑（诊断用）
#   linbox-dac reg                 只注册驱动（写入 prefix 注册表），不启动
#   linbox-dac unreg               还原 Graphics 驱动为 x11
#   linbox-dac stop                关闭 DAC 显示窗口
#
# 显示链路：
#   winedac.drv（新图形驱动）──unix socket──▶ LinBox App bridge
#     └─ ASurfaceControl/ASurfaceTransaction.setBuffer(AHardwareBuffer)
#        └─ SurfaceFlinger 直接合成（API 29+ 零拷贝；26-28 降级）
#
# Wine 运行形态自动适配：
#   [Bionic Wine] 进程内 dlopen libandroid.so 直连 AHardwareBuffer
#   [glibc Wine]  bionic 侧车 dac_allocd 代分配（脚本自动拉起）
#
# DXVK 前置：
#   pkg install mesa-vulkan-icd-turnip   （Adreno；Mali 用 panvk-limited）
#   或 lavapipe（CPU 渲染兜底，见 mesa/build-turnip-android.sh 说明）
# ============================================================

PREFIX_DIR="/data/data/com.linbox/files/usr"
SOCK="$PREFIX_DIR/tmp/linbox-dac.sock"
ALLOCD_SOCK="$PREFIX_DIR/tmp/linbox-dac-allocd.sock"
LOG="$PREFIX_DIR/tmp/linbox-dac.log"

DESKTOP_W=1280
DESKTOP_H=720
SETUP_REGISTRY=1
EXE_ARGS=()

# ---------------- 参数解析 ----------------
while [ $# -gt 0 ]; do
    case "$1" in
        -s) shift; SIZE="$1"; DESKTOP_W="${SIZE%x*}"; DESKTOP_H="${SIZE#*x}" ;;
        --x11) SETUP_REGISTRY=0 ;;
        doctor) exec linbox-dac-doctor ;;
        reg)    exec linbox-dac-reg "$DESKTOP_W" "$DESKTOP_H" ;;
        unreg)  exec linbox-dac-unreg ;;
        stop)   exec linbox-dac-stop ;;
        -h|--help) sed -n '2,32p' "$0"; exit 0 ;;
        *) EXE_ARGS+=("$1") ;;
    esac
    shift
done

log()  { echo "[linbox-dac] $*"; }
err()  { echo "[linbox-dac] 错误: $*" >&2; }
die()  { err "$*"; echo "[linbox-dac] 完整日志: $LOG" >&2; exit 1; }

: > "$LOG" 2>/dev/null || LOG=/dev/null

# ---------------- 0. 环境自检 ----------------
[ -d "$PREFIX_DIR" ] || { echo "本脚本仅可在 LinBox 终端内运行"; exit 1; }

WINE_BIN="$(command -v wine || command -v wine64)"
[ -n "$WINE_BIN" ] || die "未找到 wine —— 先安装：linbox-glibc && grun 安装 wine，或 pkg 安装 bionic 版 wine"

log "0/6 环境自检 (wine: $WINE_BIN)"

# ---------------- 1. 打开 DAC 显示窗口 ----------------
log "1/6 请求 LinBox 打开 DAC 显示窗口 (${DESKTOP_W}x${DESKTOP_H})..."
am broadcast -a com.linbox.action.DAC_START \
    --ei width "$DESKTOP_W" --ei height "$DESKTOP_H" >/dev/null 2>&1 || true

# 等待 app 广播回执（socket 出现即视为就绪，最长 10s）
WAITED=0
while [ ! -S "$SOCK" ] && [ $WAITED -lt 20 ]; do
    sleep 0.5; WAITED=$((WAITED+1))
done
[ -S "$SOCK" ] || die "DAC 显示窗口未就绪（$SOCK 不存在）。检查 LinBox 是否已升级含 DAC 模块。"

# ---------------- 2. glibc Wine：拉起 bionic 侧车 ----------------
log "2/6 检测 Wine 运行形态..."
WINE_FORM=bionic
if grun --version >/dev/null 2>&1 && [ -n "${WINE_GRUN:-}" ] || [ -f "$PREFIX_DIR/opt/glibc" ] || file "$(readlink -f "$WINE_BIN")" 2>/dev/null | grep -q "interpreter.*glibc\|ld-linux"; then
    WINE_FORM=glibc
fi

if [ "$WINE_FORM" = "glibc" ]; then
    log "  glibc Wine → 拉起 bionic 侧车 dac_allocd..."
    ALLOCD="$PREFIX_DIR/bin/dac_allocd"
    [ -x "$ALLOCD" ] || ALLOCD="$(find "$PREFIX_DIR/lib" "$PREFIX_DIR/bin" -name 'dac_allocd' -o -name 'libdac_allocd.so' 2>/dev/null | head -1)"
    [ -n "$ALLOCD" ] && [ -e "$ALLOCD" ] || die "dac_allocd 未安装（应随 APK 分发，重装 LinBox）"
    chmod +x "$ALLOCD" 2>/dev/null
    if [ ! -S "$ALLOCD_SOCK" ]; then
        TMPDIR="$PREFIX_DIR/tmp" "$ALLOCD" >>"$LOG" 2>&1 &
        echo $! > "$PREFIX_DIR/tmp/linbox-dac-allocd.pid"
        sleep 1
    fi
    [ -S "$ALLOCD_SOCK" ] || log "  警告: 侧车未就绪（桌面 CPU 路径可能降级）"
else
    log "  bionic Wine → 进程内直连 AHardwareBuffer"
fi

# ---------------- 3. 注册 winedac.drv ----------------
if [ "$SETUP_REGISTRY" = "1" ]; then
    log "3/6 注册图形驱动 Graphics=dac ..."
    linbox-dac-reg "$DESKTOP_W" "$DESKTOP_H" >>"$LOG" 2>&1 || \
        log "  警告: 注册表写入失败（继续尝试）"
else
    log "3/6 跳过注册表配置 (--x11)"
fi

# ---------------- 4. DXVK / Vulkan 预检 ----------------
log "4/6 Vulkan 环境预检..."
VK_INFO="未检测到"
if [ -n "${VK_ICD_FILENAMES:-}" ]; then
    VK_INFO="$VK_ICD_FILENAMES"
elif ls /system/vendor/lib64/hw/vulkan.* >/dev/null 2>&1; then
    VK_INFO="系统 ICD (设备 Vulkan)"
elif pkg list-installed 2>/dev/null | grep -q mesa-vulkan; then
    VK_INFO="mesa (termux pkg)"
fi
log "  Vulkan: $VK_INFO（DXVK 需要；GDI 应用可无）"

# ---------------- 5. 启动 wine（虚拟桌面模式） ----------------
log "5/6 启动 wine 虚拟桌面 (${DESKTOP_W}x${DESKTOP_H})..."
log "  链路: ${EXE_ARGS[*]:-explorer} → winedac.drv → $SOCK → SurfaceFlinger"

WINE_ENV="WINEDEBUG=err+seh,err+loaddll WINE_LOG=$LOG"
export WINEDEBUG="${WINEDEBUG:-fixme-all}"

EXE_STR="${EXE_ARGS[*]:-}"
[ -n "$EXE_STR" ] || EXE_STR="explorer"

set -- "$EXE_ARGS[@]" 2>/dev/null || set -- explorer
if [ $# -eq 0 ] || [ -z "${1:-}" ]; then set -- explorer; fi

if [ "$WINE_FORM" = "glibc" ]; then
    grun wine explorer /desktop=dac,"${DESKTOP_W}x${DESKTOP_H}" "$@" 2>>"$LOG"
else
    wine explorer /desktop=dac,"${DESKTOP_W}x${DESKTOP_H}" "$@" 2>>"$LOG"
fi
RC=$?

# ---------------- 6. 收尾 ----------------
log "6/6 wine 退出 (rc=$RC)"
[ $RC -ne 0 ] && log "  如遇问题: cat $LOG; 并运行 linbox-dac doctor"

am broadcast -a com.linbox.action.DAC_STOP >/dev/null 2>&1 || true
exit $RC
