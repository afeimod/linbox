#!/data/data/com.linbox/files/usr/bin/sh
# ============================================================
# linbox-dac-doctor — DAC 逐项体检
# ============================================================
G=1; PASS="✓"; FAIL="✗"; WARN="!"

say()   { echo "[$3] $1: $2"; }
ok()    { say "$1" "$2" "$PASS"; }
bad()   { say "$1" "$2" "$FAIL"; G=0; }
warn_() { say "$1" "$2" "$WARN"; }

echo "=============================================="
echo " LinBox DAC 体检 (Direct Android Compositing)"
echo "=============================================="

# 1. 环境
[ -d /data/data/com.linbox/files/usr ] \
    && ok "终端环境" "LinBox 前缀正常" \
    || bad "终端环境" "不在 LinBox 终端内运行"

# 2. wine
WINE_BIN="$(command -v wine || command -v wine64)"
[ -n "$WINE_BIN" ] && ok "Wine" "$WINE_BIN" || bad "Wine" "未安装（linbox-glibc / 自行安装）"

# 3. wine 形态
if [ -n "$WINE_BIN" ]; then
    if file "$(readlink -f "$WINE_BIN")" 2>/dev/null | grep -q glibc; then
        warn_ "Wine 形态" "glibc 构建（需 bionic 侧车 dac_allocd）"
    else
        ok "Wine 形态" "bionic 构建（AHB 直连可用）"
    fi
fi

# 4. winedac.drv 是否已装入 wine
if [ -n "$WINE_BIN" ]; then
    WINE_DIR="$(dirname "$(readlink -f "$WINE_BIN")")/.."
    find "$WINE_DIR/lib" -name 'winedac*' 2>/dev/null | grep -q . \
        && ok "winedac.drv" "驱动已安装" \
        || bad "winedac.drv" "wine 未包含 DAC 驱动（用 wine/build_wine_dac.sh 重建）"
fi

# 5. prefix 注册表
if [ -f "${WINEPREFIX:-$HOME/.wine}/user.reg" ]; then
    grep -q '"Graphics"="dac"' "${WINEPREFIX:-$HOME/.wine}/user.reg" \
        && ok "驱动注册" "Graphics=dac 已设置" \
        || warn_ "驱动注册" "未设置 —— 运行 linbox-dac reg"
fi

# 6. Vulkan ICD
VK_FOUND=0
for f in /system/vendor/lib64/hw/vulkan.* /odm/lib64/hw/vulkan.*; do
    [ -e "$f" ] && { ok "设备 Vulkan" "$f"; VK_FOUND=1; break; }
done
ls "$PREFIX/lib/libvulkan.so" >/dev/null 2>&1 && { ok "termux Vulkan" "loader 存在"; VK_FOUND=1; }
[ $VK_FOUND -eq 1 ] || warn_ "Vulkan" "未检测到 ICD（DXVK 不可用；GDI 应用不受影响）"

# 7. DXVK
if [ -n "$WINE_BIN" ]; then
    find "$WINE_DIR/share" "${WINEPREFIX:-$HOME/.wine}/drive_c" -name 'dxvk' -o -name 'd3d11.dll' 2>/dev/null | grep -q . \
        && ok "DXVK" "已部署" \
        || warn_ "DXVK" "未部署（dxvk/build-dxvk.sh）"
fi

# 8. app 侧 bridge
SOCK="${PREFIX:-/data/data/com.linbox/files/usr}/tmp/linbox-dac.sock"
if [ -S "$SOCK" ]; then
    ok "DAC bridge" "socket 就绪"
elif am broadcast -a com.linbox.action.DAC_STATUS >/dev/null 2>&1; then
    warn_ "DAC bridge" "socket 未开 —— DAC 窗口未启动（linbox-dac 启动时会自动开窗）"
else
    bad "DAC bridge" "LinBox 应用未响应广播（APK 需含 DAC 模块）"
fi

# 9. 设备 API 级别
API="$(getprop ro.build.version.sdk 2>/dev/null)"
case "$API" in
    2[6-8]) warn_ "设备 API" "$API —— CPU 降级呈现（无直合）" ;;
    29|3*|4*) ok "设备 API" "$API —— SurfaceFlinger 直合可用" ;;
    *) bad "设备 API" "未知 ($API)，需 ≥26" ;;
esac

# 10. 侧车（glibc wine 才需要）
if file "$(readlink -f "$WINE_BIN")" 2>/dev/null | grep -q glibc; then
    find "$PREFIX" -name 'dac_allocd*' 2>/dev/null | grep -q . \
        && ok "bionic 侧车" "dac_allocd 已安装" \
        || bad "bionic 侧车" "glibc wine 需要但未安装（重装含 DAC 的 APK）"
fi

echo "----------------------------------------------"
[ $G -eq 1 ] && echo "结论: 关键组件齐备，可以运行 linbox-dac <game.exe>" \
            || echo "结论: 存在缺失项（见 ✗ 行），修复后重试"
exit $G
