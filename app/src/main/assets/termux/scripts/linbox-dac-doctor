#!/data/data/com.linbox/files/usr/bin/sh
# ============================================================
# linbox-dac-doctor — DAC/显示栈 逐项体检 (v1.5, POSIX sh)
# ============================================================
P="${PREFIX:-/data/data/com.linbox/files/usr}"
G=1

ok()   { printf '[+] %s: %s\n' "$1" "$2"; }
bad()  { printf '[-] %s: %s\n' "$1" "$2"; G=0; }
warn() { printf '[!] %s: %s\n' "$1" "$2"; }

echo "=============================================="
echo " LinBox DAC 体检"
echo "=============================================="

# 1. 终端环境
if [ -d "$P" ]; then ok "终端环境" "LinBox 前缀正常"; else bad "终端环境" "不在 LinBox 终端内运行"; fi

# 2. wine
WINE_BIN="$(command -v wine 2>/dev/null || command -v wine64 2>/dev/null)"
if [ -n "$WINE_BIN" ]; then ok "Wine" "$WINE_BIN"; else bad "Wine" "未安装（linbox-glibc / bionic wine 包）"; fi

WINE_REAL="$(readlink -f "$WINE_BIN" 2>/dev/null || echo "")"
WINE_ROOT=""
[ -n "$WINE_REAL" ] && WINE_ROOT="$(dirname "$WINE_REAL")/../.."

# 3. wine 形态
if [ -n "$WINE_REAL" ]; then
    if file "$WINE_REAL" 2>/dev/null | grep -Eq 'interpreter.*(ld-linux|ld-)|glibc'; then
        warn "Wine 形态" "glibc 构建（DAC 需 bionic 侧车 dac_allocd）"
    else
        ok "Wine 形态" "bionic 构建（AHB 直连可用）"
    fi
fi

# 4. winedac.drv（决定 DAC 原生栈是否可用）
DAC_DRV=0
if [ -n "$WINE_ROOT" ]; then
    for d in "$WINE_ROOT/lib/wine" "$WINE_ROOT/lib64/wine" "$P/opt/wine/lib/wine"; do
        if [ -d "$d" ] && find "$d" -name 'winedac*' 2>/dev/null | grep -q .; then
            ok "winedac.drv" "驱动已安装 → DAC 原生路径可用"; DAC_DRV=1; break
        fi
    done
    [ "$DAC_DRV" = 1 ] || warn "winedac.drv" "未安装 → 部署 wine-dac tarball 启用 DAC 独立显示器（Actions 组件选 wine）"
fi

# 5. 显示栈可用性（自带 X11 环境：DISPLAY 已设 / 本机 socket / 内置 :13 一律算可用）
if [ -n "$DISPLAY" ]; then
    ok "X11 环境" "DISPLAY=$DISPLAY（已有 X server，wine 直接复用）"
elif [ -d /tmp/.X11-unix ] && ls /tmp/.X11-unix 2>/dev/null | grep -q '^X'; then
    ok "X11 环境" "检测到本机 X server socket（export DISPLAY=:<编号> 即可复用）"
elif [ -d "$P/tmp/.X11-unix" ] && ls "$P/tmp/.X11-unix" 2>/dev/null | grep -q '^X'; then
    ok "X11 环境" "检测到 LinBox 内置 X server socket（:13 链路）"
elif command -v termux-x11 >/dev/null 2>&1; then
    if pm path com.termux.x11 >/dev/null 2>&1; then
        ok "X11 显示栈" "termux-x11 + 伴侣 App 齐备（新起 :0 兜底）"
    else
        warn "X11 显示栈" "缺 Termux:X11 伴侣 App（github.com/termux/termux-x11/releases）"
    fi
else
    warn "X11 环境" "未检测到（不影响 DAC 路径）"
fi
if command -v Xvnc >/dev/null 2>&1; then
    ok "VNC 显示栈" "Xvnc 可用（127.0.0.1:5901）"
else
    warn "VNC 显示栈" "未安装（可选: pkg install tigervnc）"
fi

# 6. prefix 注册表（仅 DAC 路径相关）
if [ "$DAC_DRV" = 1 ] && [ -f "${WINEPREFIX:-$HOME/.wine}/user.reg" ]; then
    if grep -q '^"Graphics"="dac"' "${WINEPREFIX:-$HOME/.wine}/user.reg" 2>/dev/null || \
       awk '/^\[Software\\\\Wine\\\\Drivers\]/{s=1;next} s&&/^\[/{s=0} s&&/^"Graphics"="dac"/{f=1} END{exit !f}' \
           "${WINEPREFIX:-$HOME/.wine}/user.reg"; then
        ok "驱动注册" "Graphics=dac 已设置"
    else
        warn "驱动注册" "未设置 —— 运行 linbox-dac reg（仅 DAC 路径需要）"
    fi
fi

# 7. Vulkan ICD
VK_FOUND=0
for f in /system/vendor/lib64/hw/vulkan.* /odm/lib64/hw/vulkan.*; do
    if [ -e "$f" ]; then ok "设备 Vulkan" "$f"; VK_FOUND=1; break; fi
done
if [ -e "$P/lib/libvulkan.so" ]; then ok "termux Vulkan" "loader 存在"; VK_FOUND=1; fi
[ "$VK_FOUND" = 1 ] || warn "Vulkan" "未检测到 ICD（DXVK 不可用；GDI 应用不受影响）"

# 8. DXVK
if [ -n "$WINE_ROOT" ]; then
    if find "$WINE_ROOT/share" "${WINEPREFIX:-$HOME/.wine}/drive_c" -name 'd3d11.dll' 2>/dev/null | grep -q .; then
        ok "DXVK" "已部署"
    else
        warn "DXVK" "未部署（dxvk/build-dxvk.sh；纯 GDI/2D 应用不需要）"
    fi
fi

# 9. 设备 API 级别
API="$(getprop ro.build.version.sdk 2>/dev/null)"
case "$API" in
    2[6-8])    warn "设备 API" "$API —— DAC 无直合（CPU 降级）；X11/VNC 不受影响" ;;
    29|3*|4*)  ok "设备 API" "$API —— SurfaceFlinger 直合可用" ;;
    *)         warn "设备 API" "未知 ($API)" ;;
esac

# 10. 侧车（glibc wine 才需要）
if file "$WINE_REAL" 2>/dev/null | grep -Eq 'ld-linux|glibc'; then
    if find "$P" -name 'dac_allocd*' 2>/dev/null | grep -q .; then
        ok "bionic 侧车" "dac_allocd 已安装"
    else
        warn "bionic 侧车" "glibc wine 的 DAC 路径需要（随含 DAC 的 APK 分发）"
    fi
fi

echo "----------------------------------------------"
if [ "$G" = 1 ]; then
    echo "结论: 关键组件齐备，运行 linbox-dac 程序.exe 即可"
else
    echo "结论: 见 [!] 项 —— 当前可用路径已可运行；缺失项按提示补齐"
fi
exit 0
