<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 内置 X11 图形：termux-x11 模块 minSdk=26 高于宿主 24，
         与参考实现一致地放行库最低版本（X11 显示端建议 Android 8.0+） -->
    <uses-sdk tools:overrideLibrary="com.termux.x11" />

    <!-- 终端网络（apt/pkg 下载）与 X11 转发 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 终端访问共享存储（/sdcard）。
         v2.29 修复"首次启动不弹存储权限"：原声明带 maxSdkVersion=32/29，
         导致 Android 10+ 上运行时根本不存在这两个权限、系统永不弹窗
         （targetSdk=28 的 legacy 应用全版本都可授予，去掉上限）。
         MANAGE_EXTERNAL_STORAGE 作为 Android 11+ 的"所有文件访问"备选
         （用户拒绝普通授权后，引导到系统"所有文件访问"页）。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 虚拟键盘 / 虚拟手柄按键触觉反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- X11 / 终端会话前台常驻服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开发者选项：CPU 保持唤醒（终端常驻服务 partial wake lock） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开发者选项：申请忽略电池优化（降低 Doze 冻结概率） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开发者选项：停止限制子进程（幽灵进程杀手致报错 9）。
         signature|development 权限，需一次性 ADB 授权：
         adb shell pm grant com.linbox android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LinBoxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LinBox"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LinBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- X11 会话前台常驻（防止 X server/App 后台被冻结杀死）。
             会话结束（linbox-x11-stop / X server 进程死亡）时服务自动退出。
             stopWithTask=false：用户划掉任务卡后服务与进程仍存活，保护不中断。 -->
        <service
            android:name="com.linbox.apps.x11.X11KeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="X11 session keep alive" />
        </service>

        <!-- 终端会话前台常驻（v2.27）：shell/子进程树防后台冻结误杀。
             会话结束（exit / 被杀）时巡检自动退出；新建会话重新拉起。 -->
        <service
            android:name="com.linbox.apps.terminal.TerminalKeepAliveService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal session keep alive" />
        </service>
        <!-- LinBox DAC：终端 am broadcast 触发的显示入口（merge-into-repo.sh 注入） -->
        <receiver
            android:name="com.linbox.apps.dac.DacReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.linbox.action.DAC_START" />
                <action android:name="com.linbox.action.DAC_STOP" />
                <action android:name="com.linbox.action.DAC_STATUS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
